@startuml
title youRide - Building Block View Level 1

skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor Customer
actor Driver
actor "Founding Team / Admin" as Admin
actor "Controlling Employee" as Controlling

component "youRide Mobile App / Frontend" as App
component "youRide Backend\nJava Modular Monolith" as Backend
database "MySQL Database" as DB

component "External Auth Provider" as AuthProvider
component "Stripe Payment Provider" as Stripe

Customer --> App : uses
Driver --> App : uses
Admin --> App : administers
Controlling --> App : requests reports

App --> Backend : HTTPS/REST
App --> Backend : WebSocket/TLS for live tracking

Backend --> DB : stores and reads data
Backend --> AuthProvider : authenticates users
Backend --> Stripe : processes payments

@enduml
